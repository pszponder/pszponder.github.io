{{- $.Scratch.Add "index" slice -}}
{{- range where .Site.RegularPages "Type" "posts" -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "tags" .Params.tags "categories" .Params.categories "contents" (.Plain | truncate 500) "permalink" .Permalink "summary" .Summary "date" .Date) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
